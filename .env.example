# .env.local:

# S3 credentials for your self-hosted SeaweedFS S3 gateway
# Generate access keys in SeaweedFS (s3.configure / static config json)
S3_ENDPOINT=https://s3.your-domain.com
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_BUCKET_NAME=your-bucket-name
# Optional: SeaweedFS ignores region, defaults to us-east-1 if unset
S3_REGION=us-east-1

WEB_URL=url-of-your-website
# Public URL used to serve files. For path-style SeaweedFS this usually
# includes the bucket, e.g. https://s3.your-domain.com/your-bucket-name
CDN_URL=url-of-your-cdn-or-public-bucket-url
ADMIN_API_KEY=your-admin-api-key-for-panel-page
MAINTENANCE_MODE=false
REASON_FOR_MAINTENANCE=We are currently under maintenance. Please check back later.
PORT=3000
